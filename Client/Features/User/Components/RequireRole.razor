@implements IDisposable
@inject AuthStateService AuthState

@if (AuthState.IsInRole(Role))
{
    @ChildContent
}
else
{
    @NotPermitted
}

@code {
    /// <summary>Portal role the visitor must hold, one of <see cref="UserRoles"/>.</summary>
    [Parameter] [EditorRequired] public string Role { get; set; } = string.Empty;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Shown instead when the visitor lacks the role; nothing is drawn when omitted.</summary>
    [Parameter] public RenderFragment? NotPermitted { get; set; }

    protected override void OnInitialized() => AuthState.AuthStateChanged += Redraw;

    private void Redraw() => InvokeAsync(StateHasChanged);

    public void Dispose() => AuthState.AuthStateChanged -= Redraw;
}
