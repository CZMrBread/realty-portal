@page "/agent/{Id:guid}"
@using Client.Features.RealtyAgent
@using Client.Features.SRealty.Advert
@using Client.Features.SRealty.Advert.ListAdverts
@using Shared.RealtyAgent
@using Shared.Shared
@using Shared.SRealty.Advert.ListAdverts
@inject RealtyAgentApiClient RealtyAgents
@inject AdvertApiClient Adverts
@inject AuthStateService AuthState
@inject NavigationManager Navigation

<PageTitle>Realty agent</PageTitle>

<div class="container py-5">
    @if (error is not null)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    @if (agent is not null)
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h4 mb-0">@(agent.Name ?? "Realty agent")</h1>
            @if (canManage)
            {
                <div class="d-flex gap-2">
                    <a class="btn btn-outline-primary" href="agent/@Id/edit">Edit</a>
                    @if (!confirmingDelete)
                    {
                        <button class="btn btn-danger" type="button" disabled="@busy" @onclick="() => confirmingDelete = true">
                            Delete
                        </button>
                    }
                </div>
            }
        </div>

        @if (confirmingDelete)
        {
            <div class="alert alert-danger d-flex justify-content-between align-items-center" role="alert">
                <span>Remove this agent profile? The account itself stays.</span>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary btn-sm" type="button" disabled="@busy" @onclick="() => confirmingDelete = false">
                        Cancel
                    </button>
                    <button class="btn btn-danger btn-sm" type="button" disabled="@busy" @onclick="DeleteAsync">
                        @if (busy)
                        {
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                        }
                        Delete
                    </button>
                </div>
            </div>
        }

        <dl class="row">
            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@(agent.Email ?? "—")</dd>
            <dt class="col-sm-3">Phone</dt>
            <dd class="col-sm-9">@(agent.PhoneNumber ?? "—")</dd>
            <dt class="col-sm-3">Role</dt>
            <dd class="col-sm-9">@agent.AgentRole</dd>
            <dt class="col-sm-3">Registration number (IČO)</dt>
            <dd class="col-sm-9">@(agent.RegistrationNumber ?? "—")</dd>
            <dt class="col-sm-3">Agency key</dt>
            <dd class="col-sm-9">@(agent.RealtyAgentRkId ?? "—")</dd>
            <dt class="col-sm-3">Agency</dt>
            <dd class="col-sm-9">
                @if (agent.RealtyAgencyId is { } agencyId)
                {
                    <a href="agency/@agencyId">@agencyId</a>
                }
                else
                {
                    <span>Without an agency</span>
                }
            </dd>
        </dl>

        <h2 class="h5 mb-3">Adverts</h2>
        @if (adverts is { Items.Count: 0 })
        {
            <p class="text-body-secondary">The agent has no adverts yet.</p>
        }
        else if (adverts is not null)
        {
            <div class="row row-cols-1 row-cols-md-2 g-3 mb-4">
                @foreach (var advert in adverts.Items)
                {
                    <div class="col">
                        <AdvertCard Advert="advert"/>
                    </div>
                }
            </div>

            <PaginationNav Page="@adverts.Page" TotalPages="@adverts.TotalPages" PageChanged="ChangeAdvertPageAsync"/>
        }
    }
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private RealtyAgentDto? agent;
    private bool canManage;
    private string? error;
    private bool busy;
    private bool confirmingDelete;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        error = null;
        await AuthState.InitializeAsync();

        var (response, failure) = await RealtyAgents.GetAgentAsync(Id);
        if (response is null)
        {
            error = failure ?? "The agent could not be loaded.";
            return;
        }

        agent = response;
        canManage = AuthState.IsAgencyAdmin && AuthState.AgencyId is { } adminAgency
            && agent.RealtyAgencyId == adminAgency;

        advertPage = 1;
        await LoadAdvertsAsync();
    }

    private const int AdvertPageSize = 20;
    private PagedResult<SrealityAdvertDto>? adverts;
    private int advertPage = 1;

    private Task ChangeAdvertPageAsync(int number)
    {
        advertPage = number;
        return LoadAdvertsAsync();
    }

    private async Task LoadAdvertsAsync()
    {
        var (response, _) = await Adverts.GetFilteredAdvertsAsync(new AdvertFilter { SellerId = Id },
            AdvertSortEnum.Newest, advertPage, AdvertPageSize);
        adverts = response;
    }

    /// <summary>Deletes the agent profile and returns to their agency; reachable only after confirmation.</summary>
    private async Task DeleteAsync()
    {
        var agencyId = agent?.RealtyAgencyId;
        busy = true;
        error = await RealtyAgents.DeleteAgentAsync(Id);
        busy = false;

        if (error is null)
        {
            Navigation.NavigateTo(agencyId is { } id ? $"agency/{id}" : "agency");
        }
    }
}
