@using Shared.RealtyAgent
@implements IDisposable
@inject AuthStateService AuthState

@if (IsPermitted)
{
    @ChildContent
}
else
{
    @NotPermitted
}

@code {
    /// <summary>Agent role the visitor needs; <see cref="AgentRoleEnum.Agent"/> admits agency admins too.</summary>
    [Parameter] public AgentRoleEnum Role { get; set; } = AgentRoleEnum.Agent;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Shown instead when the visitor lacks the role; nothing is drawn when omitted.</summary>
    [Parameter] public RenderFragment? NotPermitted { get; set; }

    private bool IsPermitted => Role switch
    {
        AgentRoleEnum.AgencyAdmin => AuthState.IsAgencyAdmin,
        _ => AuthState.IsAgent
    };

    protected override void OnInitialized() => AuthState.AuthStateChanged += Redraw;

    private void Redraw() => InvokeAsync(StateHasChanged);

    public void Dispose() => AuthState.AuthStateChanged -= Redraw;
}
