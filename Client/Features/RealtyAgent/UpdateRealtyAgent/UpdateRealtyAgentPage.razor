@page "/agent/{Id:guid}/edit"
@using Client.Features.RealtyAgent
@using Shared.RealtyAgent
@inject RealtyAgentApiClient RealtyAgents
@inject NavigationManager Navigation

<PageTitle>Edit agent</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h1 class="h4 card-title mb-3">Edit realty agent</h1>

                    @if (error is not null)
                    {
                        <div class="alert alert-danger" role="alert">@error</div>
                    }

                    @if (agent is not null)
                    {
                        <BootstrapEditForm Model="agent" OnValidSubmit="SubmitAsync">
                            <DataAnnotationsValidator/>

                            <FloatingText Label="Full name" autocomplete="off" @bind-Value="agent.Name"/>

                            <FloatingText Label="Public email" Type="email" autocomplete="off"
                                          @bind-Value="agent.Email"/>

                            <FloatingText Label="Public phone" Type="tel" autocomplete="off"
                                          @bind-Value="agent.PhoneNumber"/>

                            <FloatingSelect TValue="AgentRoleEnum" Label="Role" @bind-Value="agent.AgentRole">
                                @foreach (var role in Enum.GetValues<AgentRoleEnum>())
                                {
                                    <option value="@role">@role</option>
                                }
                            </FloatingSelect>

                            <FloatingText Label="Agency key" autocomplete="off"
                                          Help="Key of the agent in the agency's own system, optional."
                                          @bind-Value="agent.RealtyAgentRkId"/>

                            <div class="d-flex gap-2">
                                <button class="btn btn-primary" type="submit" disabled="@busy">
                                    @if (busy)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                                    }
                                    Save
                                </button>
                                <a class="btn btn-outline-secondary" href="agent/@Id">Cancel</a>
                            </div>
                        </BootstrapEditForm>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private RealtyAgentDto? agent;
    private string? error;
    private bool busy;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        error = null;
        var (response, failure) = await RealtyAgents.GetAgentAsync(Id);
        if (response is null)
        {
            error = failure ?? "The agent could not be loaded.";
            return;
        }

        agent = response;
    }

    private async Task SubmitAsync()
    {
        busy = true;
        error = null;

        var (response, failure) = await RealtyAgents.UpdateAgentAsync(Id, agent!);
        busy = false;

        if (response is null)
        {
            error = failure ?? "The agent could not be saved.";
            return;
        }

        Navigation.NavigateTo($"agent/{Id}");
    }
}
