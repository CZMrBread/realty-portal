@page "/agency/srealty/property/update/{RealtyId:guid}"
@using Client.Components.SRealty
@using Shared.SRealtyRealty.RealtyImport
@inject HttpClient Http
@inject NavigationManager Navigation

<AuthorizeView>
    <div class="container mt-4">
        <h2>Update SRealty Property</h2>

        @if (isLoading)
        {
            <div class="d-flex justify-content-center">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }
        else if (propertyDto != null)
        {
            <SRealtyPropertyForm PropertyDto="@propertyDto"
                                OnValidSubmit="@HandleValidSubmit"
                                OnCancel="@HandleCancel"
                                IsSubmitting="@isSubmitting"
                                SubmitButtonText="Update Property" />
        }
        else
        {
            <div class="alert alert-danger">
                Property not found or failed to load.
            </div>
        }
    </div>
</AuthorizeView>

@code {
    [Parameter] public Guid RealtyId { get; set; }

    private SRealityAdvertDto? propertyDto;
    private bool isLoading = true;
    private bool isSubmitting = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadProperty();
    }

    private async Task LoadProperty()
    {
        isLoading = true;
        try
        {
            // TODO: Replace with actual endpoint when available
            var response = await Http.GetAsync($"/srealty/get/{RealtyId}");
            if (response.IsSuccessStatusCode)
            {
                propertyDto = await response.Content.ReadFromJsonAsync<SRealityAdvertDto>();
            }
            else
            {
                Console.WriteLine($"Failed to load property: {response.StatusCode}");
                // For now, create empty Dto for testing
                propertyDto = new SRealityAdvertDto { Id = RealtyId };
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception loading property: {ex.Message}");
            // For now, create empty Dto for testing
            propertyDto = new SRealityAdvertDto { Id = RealtyId };
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleValidSubmit(SRealityAdvertDto dto)
    {
        isSubmitting = true;

        try
        {
            // TODO: Replace with actual update endpoint when available
            var response = await Http.PutAsJsonAsync($"/srealty/update/{RealtyId}", dto);

            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/agency/srealty");
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Error updating property: {errorContent}");
                // TODO: Show error message to user
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception updating property: {ex.Message}");
            // TODO: Show error message to user
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void HandleCancel()
    {
        Navigation.NavigateTo("/agency/srealty");
    }
}