@using Client.Features.SRealty

@* One advert in the search results. The whole card is a link to the detail. *@

<div class="card h-100">
    <div class="card-body d-flex flex-column">
        <h2 class="h6 card-title mb-1">
            <a class="stretched-link text-decoration-none" href="srealty/@Advert.AdvertId">
                @AdvertDisplay.Title(Advert)
            </a>
        </h2>

        @{
            var location = AdvertDisplay.Location(Advert);
            var area = AdvertDisplay.MainArea(Advert);
        }
        @if (location.Length > 0)
        {
            <div class="text-body-secondary small mb-2">
                <i class="bi bi-geo-alt me-1" aria-hidden="true"></i>@location
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Advert.Description))
        {
            <p class="card-text small text-body-secondary flex-grow-1 mb-2">@Snippet(Advert.Description)</p>
        }

        <div class="d-flex justify-content-between align-items-baseline mt-auto">
            <strong>@AdvertDisplay.Price(Advert)</strong>
            @if (area is not null)
            {
                <span class="badge text-bg-light">@area</span>
            }
        </div>
    </div>
</div>

@code {
    /// <summary>Maximum description length shown before it is cut off.</summary>
    private const int SnippetLength = 160;

    [Parameter] [EditorRequired] public SrealityAdvertDto Advert { get; set; } = default!;

    private static string Snippet(string description)
        => description.Length <= SnippetLength ? description : description[..SnippetLength] + "…";
}
