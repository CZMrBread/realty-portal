@page "/agency/create"
@using Client.Features.RealtyAgency
@using Shared.RealtyAgency
@inject RealtyAgencyApiClient RealtyAgencies
@inject NavigationManager Navigation

<PageTitle>Register an agency</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h1 class="h4 card-title mb-3">Register a realty agency</h1>

                    @if (error is not null)
                    {
                        <div class="alert alert-danger" role="alert">@error</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly RealtyAgencyDto agency = new();
    private string? error;
    private bool busy;

    private Task SubmitAsync() => throw new NotImplementedException();
}
