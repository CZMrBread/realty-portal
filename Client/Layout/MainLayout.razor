@inherits LayoutComponentBase
@using Client.Services
@inject AuthService AuthService

<div class="page">
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand" href="/">Realty Portal</a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Home</a>
                    </li>
                    @if (AuthService.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/dashboard">Dashboard</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="realtyDropdown" role="button" data-bs-toggle="dropdown">
                                Realty
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="/user/realty">My Properties</a></li>
                                <li><a class="dropdown-item" href="/user/srealty">SRealty Properties</a></li>
                            </ul>
                        </li>
                    }
                </ul>
                
                <ul class="navbar-nav">
                    @if (AuthService.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <button class="btn btn-outline-light" @onclick="HandleLogout">
                                <i class="bi bi-box-arrow-right"></i> Logout
                            </button>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/register">Register</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
    
    <main>
        @Body
    </main>
</div>

@code{
    private void HandleLogout()
    {
        AuthService.Logout();
        StateHasChanged();
    }
}