@inherits AuthorizedLayoutBase

<div class="d-flex flex-column min-vh-100">
    <NavMenu/>

    <main class="flex-grow-1">
        @if (!Resolved)
        {
            <div class="container py-5 text-center">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading</span>
                </div>
            </div>
        }
        else if (!Permitted)
        {
            <AccessDeniedPanel Explanation="This part of the portal is for portal administrators."/>
        }
        else
        {
            <div class="container-fluid py-4">
                <div class="row g-4">
                    <div class="col-12 col-md-3 col-lg-2">
                        <div class="list-group">
                            <a class="list-group-item list-group-item-action" href="admin/agencies">Agencies</a>
                            <a class="list-group-item list-group-item-action" href="admin/users">Users</a>
                        </div>
                    </div>
                    <div class="col-12 col-md-9 col-lg-10">
                        @Body
                    </div>
                </div>
            </div>
        }
    </main>
</div>

@code {
    protected override bool IsPermitted() => AuthState.IsInRole(UserRoles.SuperAdmin);
}
