@using Microsoft.AspNetCore.Components.Forms

@* An EditForm whose fields carry Bootstrap validation classes. Use it in place of EditForm. *@

<EditForm EditContext="context" OnSubmit="OnSubmit" OnValidSubmit="OnValidSubmit" OnInvalidSubmit="OnInvalidSubmit"
          @attributes="AdditionalAttributes">
    @ChildContent?.Invoke(context!)
</EditForm>

@code {
    private EditContext? context;
    private object? builtFor;

    /// <summary>Object being edited. Give this or <see cref="EditContext"/>, not both.</summary>
    [Parameter] public object? Model { get; set; }

    /// <summary>An edit context of your own, when the page needs to hold on to one.</summary>
    [Parameter] public EditContext? EditContext { get; set; }

    [Parameter] public RenderFragment<EditContext>? ChildContent { get; set; }
    [Parameter] public EventCallback<EditContext> OnSubmit { get; set; }
    [Parameter] public EventCallback<EditContext> OnValidSubmit { get; set; }
    [Parameter] public EventCallback<EditContext> OnInvalidSubmit { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Builds the context when the model changes and hangs the Bootstrap class provider on it. Doing it here
    /// rather than in every page is the whole point of this component.
    /// </summary>
    /// <exception cref="InvalidOperationException">Neither a model nor an edit context was given.</exception>
    protected override void OnParametersSet()
    {
        if (EditContext is not null)
        {
            context = EditContext;
        }
        else if (Model is null)
        {
            throw new InvalidOperationException(
                $"{nameof(BootstrapEditForm)} requires a {nameof(Model)} or an {nameof(EditContext)}.");
        }
        else if (!ReferenceEquals(Model, builtFor))
        {
            context = new EditContext(Model);
            builtFor = Model;
        }

        context!.SetFieldCssClassProvider(BootstrapFieldCssClassProvider.Instance);
    }
}
