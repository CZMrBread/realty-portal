@using Shared.RealtyAgency.GetRealtyAgency

@* Public contact card of an agency; the name links to the agency detail. *@

<div class="card">
    <div class="card-body">
        <div class="d-flex align-items-center gap-3">
            <i class="bi bi-building fs-2 text-body-secondary" aria-hidden="true"></i>
            <div class="min-w-0">
                <a class="fw-semibold text-decoration-none d-block text-truncate" href="agency/@Agency.Id">
                    @Agency.Name
                </a>
                @if (!string.IsNullOrWhiteSpace(Agency.Email))
                {
                    <a class="small d-block text-truncate" href="mailto:@Agency.Email">
                        <i class="bi bi-envelope me-1" aria-hidden="true"></i>@Agency.Email
                    </a>
                }
                @if (!string.IsNullOrWhiteSpace(Agency.PhoneNumber))
                {
                    <a class="small d-block text-truncate" href="tel:@Agency.PhoneNumber">
                        <i class="bi bi-telephone me-1" aria-hidden="true"></i>@Agency.PhoneNumber
                    </a>
                }
                @if (Address is { } address)
                {
                    <div class="small text-body-secondary text-truncate">
                        <i class="bi bi-geo-alt me-1" aria-hidden="true"></i>@address
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] [EditorRequired] public GetRealtyAgencyResponse Agency { get; set; } = default!;

    /// <summary>Street, postal code and city on one line, or null when none is set.</summary>
    private string? Address
    {
        get
        {
            var town = string.Join(' ', new[] { Agency.PostalCode, Agency.City }.Where(p => !string.IsNullOrWhiteSpace(p)));
            var parts = new[] { Agency.Street, town }.Where(p => !string.IsNullOrWhiteSpace(p)).ToList();
            return parts.Count == 0 ? null : string.Join(", ", parts);
        }
    }
}
