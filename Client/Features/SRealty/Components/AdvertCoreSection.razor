@inherits AdvertFormSection
@using Client.Features.RealtyAgent
@inject RealtyAgentApiClient RealtyAgents
@inject AuthStateService AuthState

@* SrealityAdvertDto.Core.cs: what the advert is and who is selling it. *@

<div class="row">
    <div class="col-md-4">
        <EnumSelect TEnum="AdvertFunctionEnum" Label="Typ nabídky" @bind-Value="Model.AdvertFunction"/>
    </div>
    <div class="col-md-4">
        <EnumSelect TEnum="AdvertTypeEnum" Label="Kategorie" @bind-Value="Model.AdvertType"/>
    </div>
    <div class="col-md-4">
        <EnumSelect TEnum="AdvertSubtypeEnum" Label="Podkategorie" @bind-Value="Model.AdvertSubtype"
                    Filter="@(subtype => Model.AdvertType is null || subtype.IsValidSubtype(Model.AdvertType.Value))"
                    Help="Nabídka se řídí zvolenou kategorií."/>
    </div>
</div>

<div class="row">
    @if (Shows(nameof(SrealityAdvertDto.AdvertRoomCount)))
    {
        <div class="col-md-4">
            <EnumSelect TEnum="AdvertRoomCountEnum" Label="Počet místností" @bind-Value="Model.AdvertRoomCount"/>
        </div>
    }
    <div class="col-md-4">
        <EnumSelect TEnum="AdvertLifetimeEnum" Label="Doba platnosti" @bind-Value="Model.AdvertLifetime"/>
    </div>
    <div class="col-md-4">
        <EnumSelect TEnum="ExtraInfoEnum" Label="Doplňující stav" @bind-Value="Model.ExtraInfo"
                    Help="Rezervováno nebo prodáno u inzerátu, který má zůstat vidět."/>
    </div>
</div>

<div class="row">
    <div class="col-md-4">
        <FloatingText Label="Číslo inzerátu v RK" @bind-Value="Model.AdvertRkId"
                      Help="Klíč inzerátu ve vlastním systému kanceláře."/>
    </div>
    <div class="col-md-4">
        <FloatingText Label="Kód inzerátu" @bind-Value="Model.AdvertCode"/>
    </div>
    <div class="col-md-4">
        <FloatingSelect TValue="Guid?" Label="Makléř" Help="Prodávající makléř inzerátu."
                        Value="@Model.SellerId" ValueChanged="@((Guid? value) => OnSellerChanged(value))"
                        ValueExpression="@(() => Model.SellerId)">
            <option value="">— nevyplněno —</option>
            @foreach (var agent in agents)
            {
                <option value="@agent.UserId">@AgentLabel(agent)</option>
            }
        </FloatingSelect>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <CheckBoxRevealField Label="Inzerát je aktivní" @bind-Value="Model.UserStatus"/>
    </div>
    <div class="col-md-6">
        <CheckBoxRevealField Label="Exkluzivně u kanceláře" @bind-Value="Model.ExclusivelyAtRk"/>
    </div>
</div>

@code {
    private IReadOnlyList<RealtyAgentDto> agents = [];

    /// <summary>Fills the seller drop-down with the caller's agency agents, or just the caller when alone.</summary>
    protected override async Task OnInitializedAsync()
    {
        await AuthState.InitializeAsync();
        if (AuthState.AgencyId is { } agencyId)
        {
            var (page, _) = await RealtyAgents.GetAgentsAsync(agencyId, 1, 100);
            agents = page?.Items ?? [];
        }
        else if (AuthState.Claims is { } claims && AuthState.IsAgent)
        {
            var (self, _) = await RealtyAgents.GetAgentAsync(claims.UserId);
            agents = self is null ? [] : [self];
        }
    }

    /// <summary>Sets the seller by identifier and clears the agency key; an advert names one, never both.</summary>
    private void OnSellerChanged(Guid? sellerId)
    {
        Model.SellerId = sellerId;
        Model.SellerRkId = null;
    }

    private static string AgentLabel(RealtyAgentDto agent)
        => agent.UserName is { Length: > 0 } name
            ? agent.RealtyAgentRkId is { Length: > 0 } key ? $"{name} ({key})" : name
            : agent.RealtyAgentRkId ?? agent.UserId.ToString();
}
