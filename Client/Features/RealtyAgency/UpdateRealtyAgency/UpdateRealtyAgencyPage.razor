@page "/agency/{Id:guid}/edit"
@using Client.Features.RealtyAgency
@using Shared.RealtyAgency.UpdateRealtyAgency
@inject RealtyAgencyApiClient RealtyAgencies
@inject NavigationManager Navigation

<PageTitle>Edit agency</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h1 class="h4 card-title mb-3">Edit realty agency</h1>

                    @if (error is not null)
                    {
                        <div class="alert alert-danger" role="alert">@error</div>
                    }

                    @if (agency is not null)
                    {
                        <BootstrapEditForm Model="agency" OnValidSubmit="SubmitAsync">
                            <DataAnnotationsValidator/>

                            <FloatingText Label="Name" @bind-Value="agency.Name"/>

                            <FloatingText Label="Registration number (IČO)" autocomplete="off"
                                          @bind-Value="agency.RegistrationNumber"/>

                            <FloatingText Label="Email" Type="email" @bind-Value="agency.Email"/>

                            <FloatingText Label="Phone" Type="tel" autocomplete="off" @bind-Value="agency.PhoneNumber"/>

                            <FloatingText Label="Street and number" autocomplete="off" @bind-Value="agency.Street"/>

                            <div class="row">
                                <div class="col-4">
                                    <FloatingText Label="Postal code" autocomplete="off" @bind-Value="agency.PostalCode"/>
                                </div>
                                <div class="col-8">
                                    <FloatingText Label="City" autocomplete="off" @bind-Value="agency.City"/>
                                </div>
                            </div>

                            <div class="d-flex gap-2">
                                <button class="btn btn-primary" type="submit" disabled="@busy">
                                    @if (busy)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                                    }
                                    Save
                                </button>
                                <a class="btn btn-outline-secondary" href="agency/@Id">Cancel</a>
                            </div>
                        </BootstrapEditForm>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private UpdateRealtyAgencyRequest? agency;
    private string? error;
    private bool busy;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        error = null;
        var (response, failure) = await RealtyAgencies.GetAgencyAsync(Id);
        if (response is null)
        {
            error = failure ?? "The agency could not be loaded.";
            return;
        }

        agency = new UpdateRealtyAgencyRequest
        {
            Name = response.Name,
            RegistrationNumber = response.RegistrationNumber,
            Email = response.Email,
            PhoneNumber = response.PhoneNumber,
            Street = response.Street,
            City = response.City,
            PostalCode = response.PostalCode
        };
    }

    private async Task SubmitAsync()
    {
        busy = true;
        error = null;

        var (response, failure) = await RealtyAgencies.UpdateAgencyAsync(Id, agency!);
        busy = false;

        if (response is null)
        {
            error = failure ?? "The agency could not be saved.";
            return;
        }

        Navigation.NavigateTo($"agency/{Id}");
    }
}
