@page "/login"
@using Shared.User.Login
@inject AuthStateService AuthState
@inject NavigationManager Navigation

<PageTitle>Sign in</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-6 col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h1 class="h4 card-title mb-4">Sign in</h1>

                    <BootstrapEditForm Model="request" OnValidSubmit="SignInAsync">
                        <DataAnnotationsValidator/>

                        <FloatingText Label="Email" Type="email" autocomplete="username"
                                      @bind-Value="request.Email"/>

                        <FloatingText Label="Password" Type="password" autocomplete="current-password"
                                      @bind-Value="request.Password"/>

                        @if (error is not null)
                        {
                            <div class="alert alert-danger" role="alert">@error</div>
                        }

                        <button class="btn btn-primary w-100" type="submit" disabled="@busy">
                            @if (busy)
                            {
                                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                            }
                            Sign in
                        </button>
                    </BootstrapEditForm>

                    <p class="mt-3 mb-0 text-center">
                        No account yet? <a href="register">Register</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    /// <summary>Where to navigate once signed in.</summary>
    [SupplyParameterFromQuery] [Parameter] public string? ReturnUrl { get; set; }

    private readonly LoginUserRequest request = new();
    private string? error;
    private bool busy;

    private async Task SignInAsync()
    {
        busy = true;
        error = null;

        error = await AuthState.SignInAsync(request);
        busy = false;

        if (error is null)
        {
            Navigation.NavigateTo(string.IsNullOrWhiteSpace(ReturnUrl) ? "" : ReturnUrl);
        }
    }
}
