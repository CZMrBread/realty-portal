@code {
    [Parameter] public SRealityAdvertDto PropertyDto { get; set; } = new();
    [Parameter] public EventCallback<SRealityAdvertDto> OnValidSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public bool IsSubmitting { get; set; } = false;
    [Parameter] public string SubmitButtonText { get; set; } = "Submit";

    private IEnumerable<AdvertSubtypeEnum> GetValidSubtypes()
    {
        if (PropertyDto.AdvertType == default)
            return Enum.GetValues<AdvertSubtypeEnum>();

        return Enum.GetValues<AdvertSubtypeEnum>()
            .Where(subtype => subtype.IsValidSubtype(PropertyDto.AdvertType));
    }

    private void OnAdvertTypeChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<AdvertTypeEnum>(e.Value?.ToString(), out var selectedType))
        {
            PropertyDto.AdvertType = selectedType;
            PropertyDto.AdvertSubtype = default;
        }
    }

    private async Task HandleValidSubmit()
    {
        await OnValidSubmit.InvokeAsync(PropertyDto);
    }

    private void ToggleListEnum<T>(string propertyName, T enumValue, bool isChecked) where T : Enum
    {
        var property = typeof(SRealityAdvertDto).GetProperty(propertyName);
        if (property == null) return;

        var currentList = property.GetValue(PropertyDto) as List<T> ?? new List<T>();

        if (isChecked)
        {
            if (!currentList.Contains(enumValue))
            {
                currentList.Add(enumValue);
            }
        }
        else
        {
            currentList.Remove(enumValue);
        }

        property.SetValue(PropertyDto, currentList.Count > 0 ? currentList : null);
        StateHasChanged();
    }
}