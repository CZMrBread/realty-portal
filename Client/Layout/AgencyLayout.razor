@inherits AuthorizedLayoutBase

<div class="d-flex flex-column min-vh-100">
    <NavMenu/>

    <main class="flex-grow-1">
        @if (!Resolved)
        {
            <div class="container py-5 text-center">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading</span>
                </div>
            </div>
        }
        else if (!Permitted)
        {
            <AccessDeniedPanel Explanation="This part of the portal is for realty agents. You can take on an agent profile from the menu under your name."/>
        }
        else
        {
            <div class="container-fluid py-4">
                <div class="row g-4">
                    <div class="col-12 col-md-3 col-lg-2">
                        <div class="list-group">
                            <a class="list-group-item list-group-item-action" href="srealty">Adverts</a>
                            <a class="list-group-item list-group-item-action" href="srealty/create">New advert</a>
                            <RequireAgentRole Role="AgentRoleEnum.AgencyAdmin">
                                <a class="list-group-item list-group-item-action" href="agency/agents">Agents</a>
                                <a class="list-group-item list-group-item-action" href="agency/settings">Agency settings</a>
                            </RequireAgentRole>
                        </div>
                    </div>
                    <div class="col-12 col-md-9 col-lg-10">
                        @Body
                    </div>
                </div>
            </div>
        }
    </main>
</div>

@code {
    /// <summary>Every agent may work here; the agency administration entries are hidden from a plain agent.</summary>
    protected override bool IsPermitted() => AuthState.IsAgent;
}
