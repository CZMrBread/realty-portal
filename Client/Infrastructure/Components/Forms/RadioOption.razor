@typeparam TValue

@* One choice within a RadioGroupField. *@

<div class="form-check">
    <InputRadio TValue="TValue" id="@OptionId" class="@ControlClass" Value="@Value"
                @attributes="@ControlAttributes"/>
    <label class="form-check-label" for="@OptionId">
        @if (ChildContent is not null)
        {
            @ChildContent
        }
        else
        {
            @Label
        }
    </label>
</div>

@code {
    private readonly string generatedId = $"option-{Guid.CreateVersion7():N}";

    /// <summary>Value this choice stands for.</summary>
    [Parameter] public TValue? Value { get; set; }

    [Parameter] public string? Label { get; set; }

    [Parameter] public string? Id { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string OptionId => Id ?? generatedId;

    /// <summary>Bootstrap class the radio needs, plus whatever the caller asked for.</summary>
    private string ControlClass { get; set; } = "form-check-input";

    private IReadOnlyDictionary<string, object>? ControlAttributes { get; set; }

    protected override void OnParametersSet()
    {
        if (AdditionalAttributes is null || !AdditionalAttributes.TryGetValue("class", out var caller))
        {
            ControlClass = "form-check-input";
            ControlAttributes = AdditionalAttributes;
            return;
        }

        var extra = caller?.ToString();
        ControlClass = string.IsNullOrWhiteSpace(extra) ? "form-check-input" : $"form-check-input {extra}";
        ControlAttributes = AdditionalAttributes
            .Where(attribute => attribute.Key != "class")
            .ToDictionary(attribute => attribute.Key, attribute => attribute.Value);
    }
}
