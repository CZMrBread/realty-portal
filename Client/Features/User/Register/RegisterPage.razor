@page "/register"
@using Shared.User.Register
@inject AuthStateService AuthState
@inject NavigationManager Navigation

<PageTitle>Register</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-6 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h1 class="h4 card-title mb-4">Create an account</h1>

                    <BootstrapEditForm Model="request" OnValidSubmit="RegisterAsync">
                        <DataAnnotationsValidator/>

                        <FloatingText Label="User name" autocomplete="username"
                                      @bind-Value="request.UserName"/>

                        <FloatingText Label="Email" Type="email" autocomplete="email"
                                      @bind-Value="request.Email"/>

                        <FloatingText Label="Password" Type="password" autocomplete="new-password"
                                      Help="At least six characters, with an upper case letter, a lower case letter and a digit."
                                      @bind-Value="request.Password"/>

                        <FloatingText Label="Confirm password" Type="password" autocomplete="new-password"
                                      @bind-Value="request.ConfirmPassword"/>

                        @if (error is not null)
                        {
                            <div class="alert alert-danger" role="alert">@error</div>
                        }

                        <button class="btn btn-primary w-100" type="submit" disabled="@busy">
                            @if (busy)
                            {
                                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                            }
                            Register
                        </button>
                    </BootstrapEditForm>

                    <p class="mt-3 mb-0 text-center">
                        Already registered? <a href="login">Sign in</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly RegisterUserRequest request = new();
    private string? error;
    private bool busy;

    /// <summary>Creates the account; the new user arrives signed in.</summary>
    private async Task RegisterAsync()
    {
        busy = true;
        error = null;

        error = await AuthState.RegisterAsync(request);
        busy = false;

        if (error is null)
        {
            Navigation.NavigateTo("");
        }
    }
}
