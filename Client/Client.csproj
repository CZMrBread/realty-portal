<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
        <PackageReference Include="Microsoft.AspNetCore.WebUtilities" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Shared\Shared.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Content Update="wwwroot\lib\**\*.*">
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
      <AdditionalFiles Include="Features\SRealty\Advert\Components\AdvertAmenitiesSection.razor" />
      <AdditionalFiles Include="Features\SRealty\Advert\Components\AdvertAreasSection.razor" />
      <AdditionalFiles Include="Features\SRealty\Advert\Components\AdvertAuctionSection.razor" />
      <AdditionalFiles Include="Features\SRealty\Advert\Components\AdvertAvailabilitySection.razor" />
      <AdditionalFiles Include="Features\SRealty\Advert\Components\AdvertBuildingSection.razor" />
      <AdditionalFiles Include="Features\SRealty\Advert\Components\AdvertCoreSection.razor" />
      <AdditionalFiles Include="Features\SRealty\Advert\Components\AdvertEnergySection.razor" />
      <AdditionalFiles Include="Features\SRealty\Advert\Components\AdvertForm.razor" />
      <AdditionalFiles Include="Features\SRealty\Advert\Components\AdvertFormCard.razor" />
      <AdditionalFiles Include="Features\SRealty\Advert\Components\AdvertLocationSection.razor" />
      <AdditionalFiles Include="Features\SRealty\Advert\Components\AdvertMap.razor" />
      <AdditionalFiles Include="Features\SRealty\Advert\Components\AdvertOwnershipSection.razor" />
      <AdditionalFiles Include="Features\SRealty\Advert\Components\AdvertParameters.razor" />
      <AdditionalFiles Include="Features\SRealty\Advert\Components\AdvertPresentationSection.razor" />
      <AdditionalFiles Include="Features\SRealty\Advert\Components\AdvertPriceSection.razor" />
      <AdditionalFiles Include="Features\SRealty\Advert\Components\AdvertUtilitiesSection.razor" />
      <AdditionalFiles Include="Features\SRealty\Photo\Components\PhotoGallery.razor" />
    </ItemGroup>

    <Target Name="CopyBootstrapFromNode" BeforeTargets="Build">
        <!-- Cleaning -->
        <RemoveDir Directories="wwwroot\lib"/>
        <MakeDir Directories="wwwroot\lib\bootstrap\css"/>
        <MakeDir Directories="wwwroot\lib\bootstrap\js"/>
        <MakeDir Directories="wwwroot\lib\bootstrap-icons\font\fonts"/>
        <MakeDir Directories="wwwroot\lib\leaflet\images"/>

        <!-- Bootstrap CSS & JS bundle -->
        <Copy SourceFiles="node_modules\bootstrap\dist\css\bootstrap.min.css"
              DestinationFiles="wwwroot\lib\bootstrap\css\bootstrap.min.css"/>
        <Copy SourceFiles="node_modules\bootstrap\dist\js\bootstrap.bundle.min.js"
              DestinationFiles="wwwroot\lib\bootstrap\js\bootstrap.bundle.min.js"/>

        <!-- Bootstrap Icons: CSS + fonts -->
        <Copy SourceFiles="node_modules\bootstrap-icons\font\fonts\bootstrap-icons.woff2"
              DestinationFiles="wwwroot\lib\bootstrap-icons\font\fonts\bootstrap-icons.woff2"/>
        <Copy SourceFiles="node_modules\bootstrap-icons\font\fonts\bootstrap-icons.woff"
              DestinationFiles="wwwroot\lib\bootstrap-icons\font\fonts\bootstrap-icons.woff" Condition="Exists('node_modules\bootstrap-icons\font\fonts\bootstrap-icons.woff')"/>
        <Copy SourceFiles="node_modules\bootstrap-icons\font\bootstrap-icons.css"
              DestinationFiles="wwwroot\lib\bootstrap-icons\font\bootstrap-icons.css"/>

        <!-- Leaflet: CSS + JS + marker images the CSS points at -->
        <Copy SourceFiles="node_modules\leaflet\dist\leaflet.css"
              DestinationFiles="wwwroot\lib\leaflet\leaflet.css"/>
        <Copy SourceFiles="node_modules\leaflet\dist\leaflet.js"
              DestinationFiles="wwwroot\lib\leaflet\leaflet.js"/>
        <ItemGroup>
            <LeafletImages Include="node_modules\leaflet\dist\images\*.*"/>
        </ItemGroup>
        <Copy SourceFiles="@(LeafletImages)"
              DestinationFolder="wwwroot\lib\leaflet\images"/>
    </Target>

</Project>
