@page "/agent/become"
@using Client.Features.RealtyAgent
@using Shared.RealtyAgent.BecomeAgent
@inject RealtyAgentApiClient RealtyAgents
@inject AuthStateService AuthState
@inject NavigationManager Navigation

<PageTitle>Become an agent</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h1 class="h4 card-title mb-3">Become a realty agent</h1>

                    @if (!AuthState.IsAuthenticated)
                    {
                        <p>You have to be signed in to take on an agent profile.</p>
                        <a class="btn btn-primary" href="login?returnUrl=agent%2Fbecome">Sign in</a>
                    }
                    else if (AuthState.IsAgent)
                    {
                        <p class="mb-3">You are already a realty agent on this portal.</p>
                        <a class="btn btn-primary" href="srealty">Go to the adverts</a>
                    }
                    else
                    {
                        <p>
                            An agent profile lets you publish and manage adverts. You start without an agency;
                            joining one is a separate step.
                        </p>

                        <BootstrapEditForm Model="request" OnValidSubmit="BecomeAgentAsync">
                            <DataAnnotationsValidator/>

                            <FloatingText Label="Full name" autocomplete="name" @bind-Value="request.Name"/>

                            <FloatingText Label="Registration number (IČO)" autocomplete="off"
                                          @bind-Value="request.RegistrationNumber"/>

                            <FloatingText Label="Public email" Type="email" autocomplete="off"
                                          Help="Shown on your adverts, optional." @bind-Value="request.Email"/>

                            <FloatingText Label="Public phone" Type="tel" autocomplete="off"
                                          Help="Shown on your adverts, optional." @bind-Value="request.PhoneNumber"/>

                            @if (error is not null)
                            {
                                <div class="alert alert-danger" role="alert">@error</div>
                            }

                            <button class="btn btn-primary" type="submit" disabled="@busy">
                                @if (busy)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                                }
                                Become an agent
                            </button>
                        </BootstrapEditForm>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly BecomeAgentRequest request = new();
    private string? error;
    private bool busy;

    protected override async Task OnInitializedAsync() => await AuthState.InitializeAsync();

    /// <summary>Requests the agent profile and forces a token refresh; the new role travels in the token.</summary>
    private async Task BecomeAgentAsync()
    {
        busy = true;
        error = null;

        var (response, failure) = await RealtyAgents.BecomeAgentAsync(request);
        if (response is null)
        {
            error = failure ?? "Taking on an agent profile failed.";
            busy = false;
            return;
        }

        await AuthState.TryRefreshAsync(force: true);
        busy = false;
        Navigation.NavigateTo("srealty");
    }
}
