@page "/register"
@using Shared.User.Register
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Register</PageTitle>

<div class="container mt-4" style="max-width: 480px">
    <h1>Register</h1>

    <EditForm Model="_request" OnValidSubmit="HandleRegisterAsync">
        <DataAnnotationsValidator/>

        <div class="mb-3">
            <label class="form-label">Username</label>
            <InputText class="form-control" @bind-Value="_request.UserName"/>
            <ValidationMessage For="() => _request.UserName"/>
        </div>

        <div class="mb-3">
            <label class="form-label">Email</label>
            <InputText class="form-control" @bind-Value="_request.Email"/>
            <ValidationMessage For="() => _request.Email"/>
        </div>

        <div class="mb-3">
            <label class="form-label">Password</label>
            <InputText type="password" class="form-control" @bind-Value="_request.Password"/>
            <ValidationMessage For="() => _request.Password"/>
        </div>

        <div class="mb-3">
            <label class="form-label">Confirm password</label>
            <InputText type="password" class="form-control" @bind-Value="_request.ConfirmPassword"/>
            <ValidationMessage For="() => _request.ConfirmPassword"/>
        </div>

        @if (_error is not null)
        {
            <div class="alert alert-danger">@_error</div>
        }

        <button class="btn btn-primary" type="submit" disabled="@_busy">Register</button>
    </EditForm>
</div>

@code {
    private readonly RegisterUserRequest _request = new();
    private string? _error;
    private bool _busy;

    private async Task HandleRegisterAsync()
    {
        _busy = true;
        _error = null;

        var response = await Http.PostAsJsonAsync("user/register", _request);
        if (response.IsSuccessStatusCode)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        _error = await response.Content.ReadAsStringAsync();
        _busy = false;
    }
}
